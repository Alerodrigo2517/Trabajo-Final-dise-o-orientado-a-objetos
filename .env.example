APP_ENV=development
APP_NAME=Sistema de Herrería
# APP_SECRET=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=presupuesto_herreria_poo
# Cuenta técnica de MySQL para la aplicación; no es el usuario del login.
# Creala por separado en MySQL con permisos mínimos sobre esta base.
DB_USER=herreria_app
DB_PASSWORD=CAMBIAR_POR_UNA_CLAVE_SEGURA
# DB_SSL_CA=
# FERNET_KEY=
BCRYPT_ROUNDS=12
# Los roles se almacenan en la columna usuarios.rol dentro de MySQL.
SESSION_TIMEOUT_MINUTES=60
